# Database
POSTGRES_DB=spatial_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST_PORT=5433

# Backend (FastAPI)
BACKEND_HOST_PORT=8000

# Frontend (nginx)
FRONTEND_HOST_PORT=8080
# URL the *browser* uses to reach the backend
API_BASE_URL=http://localhost:8000

# Encounter (matchup) rule: what counts as "sampling the same water"
MATCH_MAX_DIST_M=50000
MATCH_MAX_DEPTH_DIFF_M=100
MATCH_MAX_TIME_DIFF_DAYS=10

# Cache: hours a fetched box stays fresh before it is fetched again
CACHE_TTL_HOURS=12

# Real data fetch
ARGO_SOURCE=erddap
# Days of data fetched for a new box (Argo and gliders)
FETCH_LOOKBACK_DAYS=30
# Largest box (in square degrees, e.g. 10 x 10) that triggers a live fetch
MAX_FETCH_AREA_DEG2=100
# Gliders: ERDDAP server with glider deployments (IOOS Glider DAC by default)
GLIDER_ERDDAP_URL=https://gliders.ioos.us/erddap
# Most glider deployments fetched per search
GLIDER_MAX_DATASETS=20
# Deployments fetched at once, and seconds before a slow one is skipped
GLIDER_PARALLEL=4
GLIDER_DATASET_TIMEOUT_S=180
# Minutes between refreshes of the glider deployment list (the server is slow to search)
GLIDER_CATALOGUE_TTL_MIN=60
# Add the synthetic test glider as well (true/false)
MOCK_GLIDER=false

# Reference-profile rule (calibration finder)
REF_MAX_DIST_M=50000
REF_MAX_TIME_DAYS=10
# Compare only below this depth (stable layer), with at least this much shared depth range
REF_LAYER_TOP_M=150
REF_MIN_OVERLAP_M=100
# Reference profiles kept per glider deployment
REF_TOP_N=5
# Re-use an Argo fetch covering the same area and dates for this many days
ARGO_FETCH_TTL_DAYS=7
# Glider requests: seconds for catalogue/metadata/dive positions; above this many dives,
# depth ranges come from the deployment metadata instead of per dive
GLIDER_SEARCH_TIMEOUT_S=120
GLIDER_PER_DIVE_MAX_PROFILES=3000

# Calibration finder: glider ERDDAP servers to catalogue (comma separated)
#   IOOS Glider DAC (US, dive-numbered layout) + DFO Canada CNODC (deep Seagliders, EGO-style trajectory layout)
GLIDER_ERDDAP_URLS=https://gliders.ioos.us/erddap,https://cnodc-cndoc.azure.cloud-nuage.dfo-mpo.gc.ca/erddap,https://linkedsystems.uk/erddap
# Trajectory-layout datasets have no dive numbers: sample every N and group into H-hour pseudo-profiles
GLIDER_TRAJ_SAMPLE=5minutes
GLIDER_TRAJ_BIN_HOURS=6
# Deployments whose reported area spans more than this many degrees are listed but not drawn
GLIDER_MAX_EXTENT_DEG=20

# Sensor check: salinity offset (glider - Argo) at equal potential temperature in the shared layer
CMP_SAL_OK=0.01
CMP_SAL_WARN=0.03
# Fewer shared temperature levels than this: no verdict
CMP_MIN_LEVELS=5

# Retention: delete profile rows not used for this many days (glider not reopened; Argo no longer relied on)
PROFILES_RETENTION_DAYS=30
# Gliders too shallow for references keep only a thinned track: one point per this many hours
GLIDER_SHALLOW_TRACK_HOURS=3
