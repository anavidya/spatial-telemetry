# Rendered at container start by the nginx image (envsubst -> /etc/nginx/conf.d/default.conf).
# Only variables defined in the container env (e.g. API_BASE_URL) are substituted.
server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Runtime config for the browser, built from env vars
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store";
        return 200 "window.APP_CONFIG = { apiBaseUrl: \"${API_BASE_URL}\" };\n";
    }

    # Dev setup: files change often, so make the browser re-check them on every load.
    # sendfile off avoids stale files on Windows/podman bind mounts.
    sendfile off;

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
